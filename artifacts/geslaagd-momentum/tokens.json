{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Geslaagd Momentum tokens in the W3C Design Tokens (DTCG) format. This is the single source of truth for the focused-momentum learning product: deep ink and forest surfaces, warm ivory text, and restrained emerald, blue, and violet aurora moments. Edit values here only -- generated CSS and portable tokens are outputs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f8f3", "$description": "Quiet paper surface for reading and forms." },
      "foreground": { "$value": "#13211c", "$description": "Ink text with warm green undertone." },
      "border": { "$value": "#d5e0d9" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#13211c" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#13211c" },
      "primary": { "$value": "#087a5b", "$description": "Momentum emerald. Drives the one obvious action, progress, and trusted links." },
      "primaryForeground": { "$value": "#f4fff8" },
      "secondary": { "$value": "#e5f0e9" },
      "secondaryForeground": { "$value": "#174638" },
      "muted": { "$value": "#edf3ee" },
      "mutedForeground": { "$value": "#52655b" },
      "accent": { "$value": "#5d43c7", "$description": "Aurora violet for selected states and moments of discovery." },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#b42318" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c5d4cc" },
      "ring": { "$value": "#087a5b" },
      "chart1": { "$value": "#087a5b" },
      "chart2": { "$value": "#2878c8" },
      "chart3": { "$value": "#5d43c7" },
      "chart4": { "$value": "#a86b00" },
      "chart5": { "$value": "#c34e55" },
      "sidebar": { "$value": "#eaf2ec" },
      "sidebarForeground": { "$value": "#234437" },
      "sidebarBorder": { "$value": "#cfddd4" },
      "sidebarPrimary": { "$value": "#087a5b" },
      "sidebarPrimaryForeground": { "$value": "#f4fff8" },
      "sidebarAccent": { "$value": "#dbe9e0" },
      "sidebarAccentForeground": { "$value": "#174638" },
      "sidebarRing": { "$value": "#087a5b" }
    },
    "dark": {
      "background": { "$value": "#081712", "$description": "Deep ink and forest base for concentrated study." },
      "foreground": { "$value": "#f7f3e8", "$description": "Warm ivory text, never stark white." },
      "border": { "$value": "#29443a" },
      "card": { "$value": "#0e211a" },
      "cardForeground": { "$value": "#f7f3e8" },
      "popover": { "$value": "#10271f" },
      "popoverForeground": { "$value": "#f7f3e8" },
      "primary": { "$value": "#6fe5b3", "$description": "Luminous emerald for the next step and verified progress." },
      "primaryForeground": { "$value": "#062218" },
      "secondary": { "$value": "#17352b" },
      "secondaryForeground": { "$value": "#e9fff1" },
      "muted": { "$value": "#142c23" },
      "mutedForeground": { "$value": "#a9c2b5" },
      "accent": { "$value": "#bcaeff", "$description": "Aurora violet for selected states and moments of discovery." },
      "accentForeground": { "$value": "#20134f" },
      "destructive": { "$value": "#f47772" },
      "destructiveForeground": { "$value": "#260b0a" },
      "input": { "$value": "#38584b" },
      "ring": { "$value": "#6fe5b3" },
      "chart1": { "$value": "#6fe5b3" },
      "chart2": { "$value": "#72baff" },
      "chart3": { "$value": "#bcaeff" },
      "chart4": { "$value": "#f2c46d" },
      "chart5": { "$value": "#ff9291" },
      "sidebar": { "$value": "#06110d" },
      "sidebarForeground": { "$value": "#e5f2e9" },
      "sidebarBorder": { "$value": "#20382f" },
      "sidebarPrimary": { "$value": "#6fe5b3" },
      "sidebarPrimaryForeground": { "$value": "#062218" },
      "sidebarAccent": { "$value": "#123127" },
      "sidebarAccentForeground": { "$value": "#e9fff1" },
      "sidebarRing": { "$value": "#6fe5b3" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Interface and body typeface: direct, warm, and easy to scan."
      },
      "serif": {
        "$value": ["Sora", "sans-serif"],
        "$description": "Display typeface for confident learning moments and outcome-led headlines."
      },
      "mono": {
        "$value": ["DM Mono", "monospace"],
        "$description": "Reserved for source, provenance, step, and system metadata."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Soft, intentional corners; enough warmth without making the product playful."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "A four-pixel rhythm that supports generous breathing room."
    }
  },
  "elevation": {
    "$type": "shadow",
    "soft": {
      "$value": "0 10px 30px rgba(3, 18, 13, 0.10)",
      "$description": "Subtle separation for an active card on an otherwise flat learning surface."
    },
    "lift": {
      "$value": "0 22px 54px rgba(3, 18, 13, 0.18)",
      "$description": "Reserved for dialogs and prompts that rise above their parent."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "160ms" },
      "base": { "$value": "240ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
        "$description": "The calm, decisive motion curve for Momentum feedback."
      }
    }
  }
}