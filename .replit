modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_vKEqPlcnbxh-4rfRPWyU9A_0bywdVDR"
VITE_SUPABASE_URL = "https://xpguhyuvooeizrjjrpkw.supabase.co"
AI_INTEGRATIONS_OPENAI_BASE_URL = "https://api.openai.com/v1"

[userenv.production]
APP_ORIGIN = "https://geslaagd.app"
APP_ALLOWED_ORIGINS = "https://geslaagd.app,https://geslaagd.me,https://geslaagdapp.replit.app"

